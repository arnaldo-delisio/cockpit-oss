# Cockpit shared secrets — template. The LIVE home is `~/.config/cockpit/env` (mode 600,
# outside the repo tree); this file only documents the names. Both brains
# read that file: systemd user units (EnvironmentFile=) and interactive shells source it,
# Claude-side skills load it directly. Clone-clean (MEM-23): real secrets never enter the
# tree; transfer values by hand over SSH.
#
# Convention: `~/.config/cockpit/env` is the ONLY env file for cockpit
# credentials, on every machine (laptop and VPS). New keys go there and nowhere else; no
# per-tool env files. When a tool insists on its own config path, symlink that path at the
# shared file rather than minting a second copy of a key. Cross-machine transfer is
# by pipe over SSH (`grep '^KEY=' | ssh <host> 'cat >> ~/.config/cockpit/env'`), never as a
# command argument and never printed: a displayed value is a leaked copy needing rotation.
# Fleet isolation still applies: client/venture credentials never enter this file.

# Groq — Whisper transcription for audio (local files + captionless videos) and the
# learned-skill hooks (taste, questions via skills/lib/learned-engine.mjs).
# Used by: watch, taste, questions
GROQ_API_KEY=

# Supadata — YouTube transcript fallback when native captions fail. Used by: watch
SUPADATA_API_KEY=

# AssemblyAI — diarized meeting transcription. Used by: record (transcribe.py), laptop-only
ASSEMBLYAI_API_KEY=

# AgentMail — reserved. Former consumer memory-engine/ingest-email.mjs removed with the
# capture-queue retirement 2026-07-26; keys kept pending an email-forwarding redesign.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# fal.ai — image generation. Used by: Hermes image tools, VPS image-generation build
FAL_KEY=

# OpenRouter — Perplexity/Sonar fallback and headless entity auto-resolve. Used by: last30days
OPENROUTER_API_KEY=

# Hetzner Cloud API token — fleet provisioning from the laptop only, a VPS itself never
# needs it. Used by: provision/provision.sh
HCLOUD_TOKEN=

# Optional, non-secret knobs read from the process env (usually left unset):
#   COCKPIT_MEMORY_ROOT     walled memory root override (MEM-32), memory-engine/paths.mjs
#   JUDGE_ADAPTER           forces ONE judge adapter (hermes|claude) for every tier, overriding the
#                           per-tier default (hard->hermes, bulk/mechanical->claude)
#   COCKPIT_RECALL=off      disables ambient recall injection (recall.mjs)
