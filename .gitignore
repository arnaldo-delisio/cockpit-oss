# Engine repo tracks SYSTEM only (layout §1/§2). Instance data lives in nested private
# repos inside this tree; engine pulls can never collide with it.

# Nested private memory DATA repo (graph, per-scope memory).
memory/

# Scope WORKSPACES: nested private dirs/repos, one per scope.
scopes/

# Secrets never enter the tree; ~/.config/cockpit/env is the home. Track .env.example only.
.env
.env.*
!.env.example

# Generated at bootstrap, never hand-edited.
shells/SOUL.generated.md

# Mid-task resume aid, single slot per thread, local-only (DOC-3).
handoff/

# The owner's decision ledger: instance data, not engine. The engine ships the ledger
# MECHANISM; the entries belong to whoever runs it, and they never enter engine history.
# In THIS tree these paths are already tracked, and git keeps tracking what is in the
# index, so the rule changes nothing here. It exists for a cloner: their own ledger,
# written on first run, stays untracked and can never ride along in a `git add -A`.
DECISIONS.md
DECISIONS-ARCHIVE.md
decisions/

# Runtime artifacts generated by skills (audio, notes, research working files).
artifacts/

# Dashboard: vendor-licensed component (AR-5 fork), kept private and never redistributed.
dashboard/

# Dependencies
node_modules/

# OS / language cruft
.DS_Store
__pycache__/
*.local

# Graphify code-graph output (regenerable in seconds; never tracked).
graphify-out/
