[Unit]
Description=Nightly trigger for the Cockpit memory "dreaming" reflect pass
Documentation=file:%h/cockpit/memory-engine/DESIGN.md

[Timer]
OnCalendar=*-*-* 04:00:00
# Spread the fire time so it never lands on a fixed second; harmless on a single host.
RandomizedDelaySec=30min
# The VPS is always on, but keep catch-up behavior for reboots that straddle 04:00.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
